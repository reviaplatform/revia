{
  "name": "revia-backend",
  "version": "1.0.0",
  "description": "Revia Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "start:prod": "pm2 delete revia-backend || true && pm2 start dist/index.js --name revia-backend",
    "start:prod-ab": "pm2 delete revia-backend || true && authbind --deep pm2 start dist/index.js --name revia-backend",
    "list": "pm2 list",
    "log": "pm2 logs revia-backend",
    "kill": "pm2 delete revia-backend",
    "seed": "ts-node -r tsconfig-paths/register ./src/database/seed.ts",
    "loadtest:token": "ts-node -r tsconfig-paths/register ./src/scripts/gen-test-token.ts",
    "loadtest": "ts-node -r tsconfig-paths/register ./src/scripts/load-test.ts",
    "matching:verify": "ts-node -r tsconfig-paths/register ./src/scripts/matching-verification.ts"
  },
  "nodemonConfig": {
    "exec": "ts-node -r tsconfig-paths/register ./src/index.ts",
    "watch": [
      "src"
    ],
    "ext": "ts"
  },
  "_moduleAliases": {
    "@type": "dist/types",
    "@server": "dist/server",
    "@": "dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "@google/genai": "^1.48.0",
    "@supabase/supabase-js": "^2.104.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/underscore": "^1.13.0",
    "@types/uuid": "^10.0.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "i18next": "^24.1.0",
    "i18next-fs-backend": "^2.6.0",
    "ioredis": "^5.6.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.46",
    "mongoose": "^8.8.4",
    "multer": "^1.4.5-lts.1",
    "node": "^23.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pm2": "^6.0.8",
    "query-string": "^9.3.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "underscore": "^1.13.8",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "xss": "^1.0.15",
    "youtube-search-api": "^2.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2"
  },
  "author": "",
  "license": "ISC"
}
