      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('providerAccessToken', res.data.accessToken);",
                  "    console.log('✅ providerAccessToken saved:', res.data.accessToken);",
                  "} else {",
                  "    console.warn('⚠️ No accessToken found in response:', JSON.stringify(res));",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
