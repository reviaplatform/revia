      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01145350998\",\n  \"languagePreference\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Validate OTP (Existing User - Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('userAccessToken', res.data.accessToken);",
                  "    console.log('✅ userAccessToken saved:', res.data.accessToken);",
                  "}",
                  "if (res && res.data && res.data.refreshToken) {",
                  "    pm.collectionVariables.set('userRefreshToken', res.data.refreshToken);",
                  "    console.log('✅ userRefreshToken saved:', res.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01145350998\",\n  \"otp\": \"102030\",\n  \"languagePreference\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/validate-exist-user-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "validate-exist-user-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Validate OTP (New User - Pre-Registration)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.registerToken) {",
                  "    pm.collectionVariables.set('userAccessToken', res.data.registerToken);",
                  "    console.log('✅ registerToken saved as userAccessToken:', res.data.registerToken);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01145350998\",\n  \"otp\": \"102030\",\n  \"languagePreference\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/validate-notexist-user-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "validate-notexist-user-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register (New User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('userAccessToken', res.data.accessToken);",
                  "    console.log('✅ userAccessToken saved after register:', res.data.accessToken);",
                  "}",
                  "if (res && res.data && res.data.refreshToken) {",
                  "    pm.collectionVariables.set('userRefreshToken', res.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"gender\": \"male\",\n  \"email\": \"john@example.com\",\n  \"birthday\": \"01:01:2003\",\n  \"languagePreference\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('userAccessToken', res.data.accessToken);",
                  "    console.log('✅ userAccessToken refreshed:', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "",
                "value": "",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
