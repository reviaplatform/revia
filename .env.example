# =============================================================================
# Revia — global environment file for `docker-compose.yml`
#
# Copy this file to `.env` in the repo root and fill in real values:
#   cp .env.example .env
#
# This file is only consumed by Docker Compose. Each app also has its own
# local `.env` for running outside Docker (`npm run dev` in each folder) —
# those are unaffected by this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (Express API) — mapped to host port BACKEND_PORT, container always 10001
# -----------------------------------------------------------------------------
BACKEND_PORT=10001
NODE_ENV=development

# MongoDB connection string — Mongo now runs as a Docker service (see the
# `mongo` service in docker-compose.yml), no Atlas cluster needed.
MONGODB_URI=mongodb://mongo:27017/revia

# JWT signing keys — use long random strings, one per role
ADMIN_ACCESS_TOKEN_KEY=changeme-admin-access-key
ADMIN_ACCESS_TOKEN_EXP=30d
PROVIDER_ACCESS_TOKEN_KEY=changeme-provider-access-key
PROVIDER_ACCESS_TOKEN_EXP=30d
USER_ACCESS_TOKEN_KEY=changeme-user-access-key
USER_ACCESS_TOKEN_EXP=30d
USER_REFRESH_TOKEN_KEY=changeme-user-refresh-key
USER_REFRESH_TOKEN_EXP=30d
REGISTER_ACCESS_TOKEN_KEY=changeme-register-access-key
REGISTER_ACCESS_TOKEN_EXP=30m

# Outgoing email (nodemailer)
EMAIL_SENDER=
EMAIL_SENDER_NAME=Revia
EMAIL_SENDER_PASSWORD=

# SMS / OTP provider
SMS_ACCESS_TOKEN=null

# File storage: "local" (writes to ./uploads, served by Express) or "s3"
STORAGE_PROVIDER=local
S3_BUCKET_NAME=null
S3_REGION=null
S3_ACCESS_KEY_ID=null
S3_SECRET_ACCESS_KEY=null

# Public base URL of the backend (used in emails/links)
DOMAIN=http://localhost:10001

# Kashier payment gateway
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=

# Google Gemini API key (AI-assisted features)
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Admin frontend — mapped to host port ADMIN_PORT, container always 3000
# NEXT_PUBLIC_* values are baked in at build time and must be reachable from
# the BROWSER (not the Docker network), so they should point at the host
# machine / public domain, e.g. http://localhost:10001 or https://api.yourdomain.com
# -----------------------------------------------------------------------------
ADMIN_PORT=3000
ADMIN_NEXT_PUBLIC_API_URL=http://localhost:10001/api/v1/admin

# -----------------------------------------------------------------------------
# Customer frontend — mapped to host port CUSTOMER_PORT, container always 3000
# -----------------------------------------------------------------------------
CUSTOMER_PORT=3001
CUSTOMER_NEXT_PUBLIC_API_URL=http://localhost:10001

# -----------------------------------------------------------------------------
# Provider frontend — mapped to host port PROVIDER_PORT, container always 3000
# -----------------------------------------------------------------------------
PROVIDER_PORT=3002
PROVIDER_NEXT_PUBLIC_API_URL=http://localhost:10001
